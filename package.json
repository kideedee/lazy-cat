{
  "name": "sonvq.dev",
  "version": "2.0.0",
  "scripts": {
    "start": "cross-env PORT=3435 next dev",
    "dev": "cross-env PORT=3434 INIT_CWD=$PWD next dev",
    "build": "cross-env INIT_CWD=$PWD next build && npm run postbuild",
    "postbuild": "cross-env NODE_OPTIONS='--experimental-json-modules' tsx ./scripts/post-build.ts",
    "serve": "next start",
    "clean": "shx rm -rf .next .contentlayer .cache node_modules pnpm-lock.yaml",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir app --dir components --dir lib --dir layouts --dir scripts",
    "biome:lint": "biome lint --write --unsafe",
    "biome:format": "biome format --write",
    "biome:fix": "biome check --write",
    "prepare": "husky",
    "db:init": "npx drizzle-kit generate && npx drizzle-kit push",
    "db:studio": "npx drizzle-kit studio --port 8088",
    "seed": "tsx ./scripts/seed.ts",
    "typecheck": "npx tsc -b"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@giscus/react": "^3.1.0",
    "@headlessui/react": "2.2.4",
    "@next/bundle-analyzer": "15.3.3",
    "@octokit/graphql": "^9.0.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/speed-insights": "^1.3.1",
    "body-scroll-lock": "4.0.0-beta.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "contentlayer2": "0.5.8",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "esbuild": "0.25.5",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "image-size": "2.1.0",
    "js-yaml": "^4.3.2",
    "kbar": "0.1.0-beta.45",
    "lucide-react": "^0.515.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "next": "15.5.29",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "postgres": "^3.4.9",
    "probe-image-size": "^7.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-medium-image-zoom": "^5.4.9",
    "react-share": "^5.3.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-preset-minify": "7.0.1",
    "rehype-pretty-code": "^0.14.6",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^1.3.1",
    "remark-math": "^6.0.0",
    "rss-parser": "^3.13.0",
    "shiki": "^3.23.0",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.5",
    "typed.js": "^2.1.0",
    "unist-util-visit": "^5.2.0",
    "wrangler": "^4.168.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@svgr/webpack": "^8.1.0",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/unist": "^3.0.3",
    "cross-env": "^7.0.3",
    "csv-parser": "^3.2.1",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "shx": "^0.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "@vercel/speed-insights",
      "contentlayer2",
      "esbuild",
      "protobufjs",
      "sharp",
      "workerd"
    ]
  }
}
